# Copy to .env and uncomment the settings you need: cp -n .env.example .env
# scripts/train.py reads this file; the other scripts read the same variables from the environment.

# Storage roots (default: ./data and ./output inside the repository; symlinks to larger disks are fine)
# DATA_ROOT=/path/to/data
# OUTPUT_ROOT=/path/to/output

# Downloaded karpathy/fineweb-edu-100b-shuffle shards (default: ${DATA_ROOT}/fineweb-edu-100b-shuffle)
# FINEWEB_EDU_DIR=/path/to/fineweb-edu-100b-shuffle

# Megatron-LM checkout at commit ed6ac270ba (default: ../Megatron-LM next to this repository)
# MEGATRON_LM_PATH=/path/to/Megatron-LM

# Hugging Face cache and offline mode
# HF_HOME=/path/to/data/cache/huggingface
# HF_HUB_OFFLINE=1

# Weights & Biases, used with scripts/train.py --wandb-project <name>
# WANDB_API_KEY=
